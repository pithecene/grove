{
  "name": "grove",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "pnpm --filter @grove/app dev",
    "build": "pnpm --filter @grove/app build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "undici": ">=7.29.1",
      "rollup": ">=4.59.0",
      "esbuild@<0.28.1": ">=0.28.1",
      "srvx": ">=0.11.13"
    }
  }
}
