# Grove — environment variables
# Copy to .env and fill in real values

# GitHub Personal Access Token
# Create one at https://github.com/settings/tokens
# Required scopes: read:user, repo (for private repository visibility)
GROVE_GITHUB_TOKEN=

# SQLite database path (default: data/grove.db, relative to the process
# working directory — use an absolute path when running from the repo root)
# GROVE_DB_PATH=data/grove.db

# Portfolio scope — explicit selection of what Grove observes.
# Unset: every repository the token can reach. Values are private to this
# deployment; keep them in .env, not in the repository.
# GROVE_SCOPE_OWNERS=your-org,your-user
# GROVE_SCOPE_EXCLUDE=your-org/some-repo
